        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\n&#39; --- HERENCIAS DE PERSONA ---\nPersona &lt;|-- Conductor\nPersona &lt;|-- Pasajero\nPersona &lt;|-- Peaton\n\n&#39; --- HERENCIAS DE VEHICULO ---\nVehiculo &lt;|-- Auto\nVehiculo &lt;|-- Camion\nVehiculo &lt;|-- Colectivo\n\n&#39; --- HERENCIAS DE ESTRUCTURA ---\nEstructura &lt;|-- Calle\nEstructura &lt;|-- Autopista\nEstructura &lt;|-- Rotonda\n\n&#39; --- RELACIONES Y CARDINALIDADES ---\nConductor \&quot;1\&quot; *-- \&quot;1\&quot; Vehiculo : conduce\nVehiculo \&quot;1\&quot; *-- \&quot;0..*\&quot; Pasajero : lleva\nVehiculo \&quot;*\&quot; --&gt; \&quot;1\&quot; Estructura : ubicado en\nVehiculo \&quot;*\&quot; --&gt; \&quot;*\&quot; Semaforo : observa\n\n&#39; --- CLASES Y ATRIBUTOS ---\nabstract class Persona {\n    - id: int\n    - nombre: String\n    - edad: int\n    + getId(): int\n    + getNombre(): String\n}\n\nclass Conductor {\n    - licenciaConducir: String\n    - vehiculoAsignado: Vehiculo\n    + asignarVehiculo(vehiculo: Vehiculo): void\n    + conducir(): void\n}\n\nclass Pasajero {\n    - origen: String\n    - destino: String\n    + subirAlVehiculo(): void\n    + bajarDelVehiculo(): void\n}\n\nclass Peaton {\n    - ubicacionActual: String\n    + cruzarEstructura(estructura: Estructura): void\n}\n\nabstract class Vehiculo {\n    - patente: String\n    - modelo: String\n    - velocidadMax: float\n    - conductor: Conductor\n    - pasajeros: List&lt;Pasajero&gt;\n    - estructuraActual: Estructura\n    + acelerar(): void\n    + frenar(): void\n    + agregarPasajero(pasajero: Pasajero): void\n    + removerPasajero(pasajero: Pasajero): void\n    + transitar(estructura: Estructura): void\n    + getEstructuraActual(): Estructura\n    + reaccionarSemaforo(semaforo: Semaforo): void\n}\n\nclass Auto {\n    - cantidadPuertas: int\n}\n\nclass Camion {\n    - capacidadCargaKg: float\n}\n\nclass Colectivo {\n    - numeroLinea: int\n    - capacidadPasajeros: int\n}\n\nabstract class Estructura {\n    - id: int\n    - nombre: String\n    - limiteVelocidad: float\n    + getLimiteVelocidad(): float\n}\n\nclass Calle {\n    - tieneCrucePeatonal: boolean\n}\n\nclass Autopista {\n    - cantidadCarriles: int\n    - tienePeaje: boolean\n}\n\nclass Rotonda {\n    - radioMetros: float\n    - cantidadSalidas: int\n}\n\nclass Semaforo {\n    - id: int\n    - estadoActual: String\n    - tiempoCambioSegundos: int\n    + cambiarEstado(): void\n    + getEstadoActual(): String\n}\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="kqngPQT5lcojP6hITZ8b-7">
